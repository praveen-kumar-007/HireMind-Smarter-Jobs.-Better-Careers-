# =================================================================
# HireMind Backend Environment Configuration (Production Template)
# =================================================================

# 1. Database Configuration (TiDB Cloud / PostgreSQL / MySQL)
# Set your managed cloud database URI here (e.g. TiDB Serverless, Supabase, Render PostgreSQL)
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/job_assistant
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=job_assistant
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 2. Redis Configuration (Optional for caching and queues)
REDIS_HOST=redis
REDIS_PORT=6379

# 3. Security & JWT Configuration
JWT_SECRET=change_this_to_a_secure_random_64_character_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# 4. Active AI Engine (local | cloud | ollama)
AI_PROVIDER=cloud

# 5. Groq Cloud LPU (~300 tokens/sec - Get free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=15

# 6. Google Gemini Cloud AI (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20

# 7. NVIDIA NIM GPU Cloud (Get free key at https://build.nvidia.com/)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_API_KEY_FALLBACK=
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TIMEOUT=60

# 8. Local Ollama (Required only if running on-device AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 9. Playwright Browser Automation Configuration
PLAYWRIGHT_HEADLESS=true
CHROME_CDP_URL=http://127.0.0.1:9222
TAILOR_RESUME=false

# 10. Server Settings & CORS Origins
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "https://*.vercel.app", "https://*.onrender.com"]
