# Environment Variables & Secrets (Ignore all real .env files anywhere)
.env
.env.*
*.env
.env.production
.env.*.production
*.env.production
**/.env
**/.env.*
**/.env.production
**/.env.*.production
!**/.env.example
!**/.env.*.example

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/

# Node.js dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Python compiled files & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.oxlintrc.json

# Local logs & Telemetry
*.log
logs/
backend/app/static/*.log
backend/app/static/browser_profile*/

# SQLite Databases
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# Generated Uploads & Resumes
backend/uploads/*
!backend/uploads/.gitkeep
backend/app/static/resumes/*.pdf
backend/faiss_indexes/

# OS-specific files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

