# ==============================================================================
# HireMind — Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your own values before starting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server Settings
# ------------------------------------------------------------------------------
# The host IP the FastAPI server will bind to. Use '127.0.0.1' for local dev.
HOST=127.0.0.1

# The port the FastAPI server runs on (default: 8000)
PORT=8000

# The name of the project
PROJECT_NAME=HireMind


# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL)
# ------------------------------------------------------------------------------
# Database user account (usually 'root' in local environments)
MYSQL_USER=root

# Password for the database user account (never commit actual passwords)
MYSQL_PASSWORD=your_mysql_password_here

# The name of the database created for the project (e.g., job_assistant)
MYSQL_DB=job_assistant

# Host IP/Domain of the MySQL database server
MYSQL_HOST=127.0.0.1

# Port number of the MySQL server (default is 3306)
MYSQL_PORT=3306

# Database connection URL.
# If left commented or empty, it will be automatically constructed from the values above.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3306/job_assistant


# ------------------------------------------------------------------------------
# 3. Redis Configuration (Required if using Redis caching or queue systems)
# ------------------------------------------------------------------------------
# Redis server host address
REDIS_HOST=localhost

# Redis server port (default is 6379)
REDIS_PORT=6379


# ------------------------------------------------------------------------------
# 4. Security & JWT Settings
# ------------------------------------------------------------------------------
# SECRET KEY used for signing JWT tokens. 
# Generate a secure random string (e.g. via 'openssl rand -hex 32')
JWT_SECRET=your_jwt_secret_key_must_be_long_and_secure_here

# Encryption algorithm used to sign the tokens (default: HS256)
JWT_ALGORITHM=HS256

# How long access tokens remain valid in minutes (e.g., 60 minutes = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------------------------
# 5. AI Service Configuration
# ------------------------------------------------------------------------------
# Choose which AI provider to use. Options: 'ollama' (local) or 'nvidia' (cloud fallback)
AI_PROVIDER=ollama

# --- Nvidia NIM Cloud AI (Required if AI_PROVIDER=nvidia or used as fallback) ---
# Base API endpoint for NVIDIA NIM integration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Your primary NVIDIA NIM API developer key
NVIDIA_API_KEY=your_nvidia_api_key_here

# Fallback NVIDIA NIM API key in case limits are reached on the primary key
NVIDIA_API_KEY_FALLBACK=your_fallback_nvidia_api_key_here

# Primary model name to use on NVIDIA NIM
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Fast reasoning model name to use on NVIDIA NIM
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Timeout (in seconds) for calls to the NVIDIA APIs
NVIDIA_TIMEOUT=60

# --- Local Ollama AI (Required if AI_PROVIDER=ollama) ---
# Local Ollama service address (usually http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Main model to pull and run via Ollama (e.g. qwen3:8b, llama3, etc.)
OLLAMA_PRIMARY_MODEL=qwen3:8b

# Faster/smaller fallback model for quicker text processing tasks (e.g. qwen3:4b)
OLLAMA_FAST_MODEL=qwen3:4b

# Timeout (in seconds) for Ollama inference queries
OLLAMA_TIMEOUT=120

# Embedding model name used for Vector Search/semantic analysis (e.g., all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2


# ------------------------------------------------------------------------------
# 6. Playwright Browser Automation Configuration
# ------------------------------------------------------------------------------
# Set to 'false' if you want a visible Chrome browser window to pop up and watch
# the auto-apply bot type/click in real time. Set to 'true' for silent headless mode.
PLAYWRIGHT_HEADLESS=false

# Port/URL of existing Chrome instance remote debugging connection (CDP).
# Enables joining existing developer browser instances rather than launching fresh.
CHROME_CDP_URL=http://127.0.0.1:9222


# ------------------------------------------------------------------------------
# 7. Frontend Proxy Configurations
# ------------------------------------------------------------------------------
# CORS Allowed origins. Enter the URL where the React/Vite development server is running.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# URL of the backend API target for the frontend dev server proxy
VITE_BACKEND_URL=http://localhost:8000
