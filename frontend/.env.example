# HireMind Frontend Environment Configuration (Example Template)

# API Base Endpoint
# Local Development: Uses Vite proxy '/api'
# Production Deployment: Set to your live backend URL (e.g. https://hiremind-smarter-jobs-better-careers.onrender.com/api)
VITE_API_URL=https://hiremind-smarter-jobs-better-careers.onrender.com/api

# Backend Server URL for local Vite dev proxying
VITE_BACKEND_URL=http://localhost:8000
